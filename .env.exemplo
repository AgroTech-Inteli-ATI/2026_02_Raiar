# Fonte RTSP: rtsp://USUARIO:SENHA@IP_DO_DVR:554/caminho/stream
# Para USB, troque por: /dev/video0 e use compose.usb.yaml.
RAIAR_CAMERA_SOURCE=rtsp://USUARIO:SENHA@IP_DO_DVR:554/caminho/stream
# Simulação sem DVR: rtsp://dvr-sim:8554/camera1 (suba também o perfil "simulacao").
# RAIAR_CAMERA_ID é o camera.id cadastrado no banco, por exemplo 1.
RAIAR_CAMERA_ID=1
# Intervalo entre quadros em segundos; o mínimo aceito é 5.
RAIAR_INTERVAL_SECONDS=5

# URL da Edge Function de ingestão no Supabase (supabase/functions/ingest-analyses).
RAIAR_SYNC_URL=https://PROJECT_REF.supabase.co/functions/v1/ingest-analyses
# Mesmo valor do segredo RAIAR_SYNC_TOKEN da Edge Function. Nunca coloque um token real aqui.
RAIAR_SYNC_TOKEN=SUBSTITUA_NO_ARQUIVO_ENV_LOCAL

# Grupo video no host, consultável com: getent group video | cut -d: -f3
VIDEO_GID=983
RAIAR_DATA=/opt/raiar/data
RAIAR_TAG=0.1.0
MODELO=coco
