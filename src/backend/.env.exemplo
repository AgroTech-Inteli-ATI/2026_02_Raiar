# PostgreSQL local ou connection string do Supabase (pooler em modo session ou conexao direta).
DATABASE_URL=postgresql://raiar:raiar_local@localhost:5432/raiar
# false apenas no PostgreSQL local; em conexoes remotas use true e certificado confiavel.
DATABASE_SSL=false
PORT=3000
HOST=127.0.0.1
# Gere dois segredos diferentes com pelo menos 32 caracteres. Nao publique os valores reais.
RAIAR_API_TOKEN=SUBSTITUA_POR_UM_SEGREDO_DE_32_CARACTERES_OU_MAIS
RAIAR_SYNC_TOKEN=SUBSTITUA_POR_OUTRO_SEGREDO_DE_32_CARACTERES_OU_MAIS
# Opcional: JWT de usuarios do Supabase Auth. O papel vem de app_metadata.role (gestor/operador).
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=CHAVE_PUBLICAVEL_DO_PROJETO
