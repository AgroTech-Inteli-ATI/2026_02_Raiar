# Caminho relativo atendido pelo proxy local do Vite; não inclua domínio aqui.
VITE_API_BASE_URL=/api
# Endereço local do backend, lido somente pelo processo Node do Vite.
RAIAR_BACKEND_URL=http://127.0.0.1:3000
# Token de desenvolvimento igual ao RAIAR_API_TOKEN do backend local.
# Deixe vazio para consultar somente /health e preencher antes de usar cadastros protegidos.
RAIAR_DEV_API_TOKEN=
